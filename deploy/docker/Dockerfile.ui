FROM node:22-bookworm-slim AS frontend
WORKDIR /build/black-ui/frontend
COPY black-ui/frontend/package.json black-ui/frontend/package-lock.json ./
RUN npm ci
COPY black-ui/frontend/ ./
RUN npm run build

FROM rust:slim-bookworm AS server
WORKDIR /build
COPY . .
RUN cargo build --release --bin black-ui

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=server /build/target/release/black-ui /usr/local/bin/black-ui
COPY --from=frontend /build/black-ui/frontend/dist /usr/share/black-ui/frontend/dist
EXPOSE 18080
ENTRYPOINT ["/usr/local/bin/black-ui"]
