[Unit]
Description=blackwire proxy runtime
Documentation=https://github.com/mojindri/Blackwire
After=network-online.target
Wants=network-online.target

[Service]
User=blackwire
Group=blackwire
ExecStart=/usr/bin/blackwire run
LoadCredential=database-url:/etc/blackwire/runtime-database-url
WorkingDirectory=/var/lib/blackwire
Restart=on-failure
RestartSec=5s
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blackwire /run/blackwire
PrivateTmp=true
NoNewPrivileges=true
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
