[Unit]
Description=black-ui Blackwire control panel
Documentation=https://github.com/mojindri/Blackwire
After=network-online.target
Wants=network-online.target

[Service]
# Use the same unprivileged account and install prefix as scripts/install.sh.
User=blackwire
Group=blackwire
ExecStart=/usr/local/bin/black-ui
WorkingDirectory=/var/lib/black-ui
LoadCredential=database-url:/etc/blackwire/ui-database-url
Environment=BLACK_UI_LISTEN=127.0.0.1:18080
Environment=BLACK_UI_STATIC_DIR=/usr/local/share/black-ui/frontend/dist
Environment=BLACK_UI_COOKIE_SECURE=0
Restart=on-failure
RestartSec=5s
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
